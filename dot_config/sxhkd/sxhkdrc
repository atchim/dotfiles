# Switch keyboard layout to pt-BR (ABNT2).
super + space ; k ; b
  setxkbmap -model abnt2 -layout br \
  && notify-send --urgency=low "Changed keyboard layout to pt-BR"

# Switch keyboard layout to en-US.
super + space ; k ; u
  setxkbmap -layout us \
  && notify-send --urgency=low "Changed keyboard layout to en-US"

# Open a new terminal window (reusing an existing alacritty daemon if any).
super + Return
  alacritty msg create-window || alacritty

# Open alsamixer in a floating terminal.
super + space ; m
  alacritty msg create-window --class floating -e alsamixer -g \
    || alacritty --class floating -e alsamixer -g

# Open htop in a floating terminal.
super + space ; t
  alacritty msg create-window --class floating -e htop \
    || alacritty --class floating -e htop

# Open the rofi run launcher.
super + space ; space
  rofi -modi run -show run -theme dmenu

# Toggle polybar visibility; reclaim bspwm's bottom padding on hide because
# polybar's hidden window keeps its strut. Successive presses cycle the body
# via sxhkd's same-LHS alternation.
super + b
  cmd={hide,show}; \
  [ "$cmd" = hide ] && bspc config bottom_padding 0; \
  polybar-msg cmd $cmd

# Reload sxhkd's configuration in place.
super + ctrl + l ; s
  pkill -USR1 --exact sxhkd

# Restart polybar in place; re-reads the loaded config files (does not
# re-probe hardware — for that, re-run polybar-launch).
super + ctrl + l ; b
  polybar-msg cmd restart

# Restart dunst in place (no SIGUSR signal exists; kill + respawn).
super + ctrl + l ; d
  pkill dunst; dunst &
