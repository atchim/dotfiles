#!/bin/bash

# audio-jack-monitor — reset Master volume on headphone plug/unplug.
#
# The card is discovered at start by scanning ALSA cards for one carrying a
# `Headphone Jack` control. If none is found, the script exits cleanly with
# a stderr note (no codec, nothing to manage).
#
# Volume Scale:
#   `VOL_ATTACHED` and `VOL_DETACHED` are alsamixer-displayed percentages
#   (the perceptual number under each bar in alsamixer, not amixer's
#   dB-linear `%`). At reconcile time the codec's dB range is probed and
#   the target dB is computed via alsamixer's own formula:
#     normalized = 10^((dB - max_dB) / 60), floored at min_dB.
#   The result is applied with `amixer set Master <dB>dB`.
#
# Subcommands:
#   reconcile  apply the table value for the current Headphone Jack state.
#              Idempotent; clobbers any current Master level. Default
#              subcommand.
#   watch      reconcile once, then run `alsactl monitor` and reconcile
#              only on Headphone Jack state transitions. Manual Master
#              nudges between transitions are preserved (the watch loop
#              filters so reconcile fires only when `Headphone Jack` flips).

set -eu

readonly VOL_ATTACHED=41
readonly VOL_DETACHED=66
readonly JACK_KCTL='Headphone Jack'
readonly MASTER_KCTL='Master'

# Print usage to stdout.
help() {
  cat - <<EOF
audio-jack-monitor
reset Master on Headphone Jack plug/unplug

USAGE
  audio-jack-monitor [reconcile|watch]
  audio-jack-monitor -h

FLAGS
  -h  --help  print this help message and exit

SUBCOMMANDS
  reconcile  apply the table value for the current jack state (default)
  watch      reconcile once, then react to jack-state transitions
EOF
}

# Print an error to stderr.
err() { printf 'audio-jack-monitor: %s\n' "$*" >&2; }

# Echo the first card index whose controls include the Headphone Jack kctl.
probe_card() {
  for d in /proc/asound/card[0-9]*; do
    [[ -d $d ]] || continue
    n=${d#/proc/asound/card}
    if amixer -c "$n" controls 2>/dev/null \
      | grep -qF "name='${JACK_KCTL}'"; then
      printf '%s' "$n"
      return 0
    fi
  done
  return 1
}

# Echo the Headphone Jack boolean ("on" or "off") for card $1.
jack_state() {
  amixer -c "$1" cget "iface=CARD,name=${JACK_KCTL}" 2>/dev/null \
    | awk -F'=' '/^[[:space:]]*: values=/{ print $NF; exit }'
}

# Echo `min_dB max_dB` for the Master playback control on card $1.
probe_db_range() {
  amixer -c "$1" cget "iface=MIXER,name=${MASTER_KCTL} Playback Volume" \
    2>/dev/null | awk '
      {
        if (match($0, /max=[0-9]+/)) {
          raw_max = substr($0, RSTART+4, RLENGTH-4) + 0
        }
        if (match($0, /dBscale-min=-?[0-9.]+dB/)) {
          v = substr($0, RSTART+12, RLENGTH-12); sub(/dB$/, "", v)
          min_db = v + 0
        }
        if (match($0, /,step=[0-9.]+dB/)) {
          v = substr($0, RSTART+6, RLENGTH-6); sub(/dB$/, "", v)
          step = v + 0
        }
      }
      END {
        if (raw_max && step > 0) {
          printf "%.4f %.4f\n", min_db, min_db + raw_max * step
        }
      }
    '
}

# Echo the dB target for alsamixer-percent $1, given min_dB $2 and max_dB $3.
target_db() {
  awk -v pct="$1" -v min_db="$2" -v max_db="$3" 'BEGIN {
    l10 = log(10)
    min_norm = exp((min_db - max_db) * l10 / 60)
    target = (pct / 100) * (1 - min_norm) + min_norm
    printf "%.2f", max_db + 60 * log(target) / l10
  }'
}

# Set Master on card $1 to alsamixer-percent $2.
set_master() {
  range=$(probe_db_range "$1")
  if [[ -z $range ]]; then
    err "card $1: no dB range for ${MASTER_KCTL}; cannot map percent"
    return 1
  fi
  read -r min_db max_db <<<"$range"
  db=$(target_db "$2" "$min_db" "$max_db")
  amixer -c "$1" -q set "$MASTER_KCTL" -- "${db}dB"
}

# Apply the table value for the current Headphone Jack state on card $1.
reconcile() {
  case "$(jack_state "$1")" in
    on) set_master "$1" "$VOL_ATTACHED" ;;
    off) set_master "$1" "$VOL_DETACHED" ;;
    *) err "unknown jack state on card $1; skipping" ;;
  esac
}

# Reconcile once on card $1, then reconcile per jack-state transition.
watch() {
  reconcile "$1"
  last=$(jack_state "$1")
  alsactl monitor "hw:$1" | while IFS= read -r _; do
    state=$(jack_state "$1")
    if [[ $state != "$last" ]]; then
      reconcile "$1"
      last=$state
    fi
  done
}

# Parse args, probe the card, dispatch to the subcommand.
main() {
  case "${1-reconcile}" in
    -h | --help)
      help
      exit 0
      ;;
  esac
  if ! card=$(probe_card); then
    err 'no card with Headphone Jack control; nothing to manage'
    exit 0
  fi
  case "${1-reconcile}" in
    reconcile) reconcile "$card" ;;
    watch) watch "$card" ;;
    *)
      err "unknown subcommand: $1"
      exit 2
      ;;
  esac
}

main "$@"
