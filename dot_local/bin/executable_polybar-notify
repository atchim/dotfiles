#!/bin/sh

# polybar-notify — pop a notify-send bubble with a status module's value.
#
# One helper per click-action across the bar. Consolidating into a single
# script avoids near-identical one-liner helpers and keeps the
# escape-cascade away from polybar's ini parser.
#
# Subcommands:
#   backlight   computes percent from $BACKLIGHT brightness vs max_brightness
#   cpu         reads the percent stashed by polybar-cpu
#   volume      reads the default-sink volume via wpctl

set -eu

readonly STATE_DIR="${XDG_RUNTIME_DIR:-/tmp}"

main() {
  case "${1-}" in
    backlight)
      b=$(cat -- "/sys/class/backlight/${BACKLIGHT-}/brightness" 2>/dev/null || true)
      m=$(cat -- "/sys/class/backlight/${BACKLIGHT-}/max_brightness" 2>/dev/null || true)
      if [ "$b" != "" ] && [ "$m" != "" ] && [ "$m" -gt 0 ]; then
        notify-send 'Brightness' "$((b * 100 / m))%"
      else
        notify-send 'Brightness' '?'
      fi
      ;;
    cpu)
      # Matches polybar-cpu's per-monitor state path.
      file="${STATE_DIR}/polybar-cpu${MONITOR:+.${MONITOR}}.pct"
      pct=0
      if [ -r "$file" ]; then
        pct=$(cat -- "$file")
      fi
      notify-send 'CPU usage' "${pct}%"
      ;;
    volume)
      v=$(wpctl get-volume @DEFAULT_AUDIO_SINK@ 2>/dev/null \
        | awk '{ printf "%d%%", $2 * 100; if ($3 == "[MUTED]") printf " (muted)" }')
      notify-send 'Volume' "${v:-?}"
      ;;
    '')
      printf 'polybar-notify: missing module name\n' >&2
      exit 2
      ;;
    *)
      printf 'polybar-notify: unknown module: %s\n' "$1" >&2
      exit 2
      ;;
  esac
}

main "$@"
