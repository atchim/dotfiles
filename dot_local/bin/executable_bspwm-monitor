#!/bin/sh

# bspwm-monitor — reconcile bspwm + xrandr to the live monitor topology.
#
# Subcommands (all idempotent; default is `reconcile`):
#   reconcile        Detect current state and apply dual/single layout.
#   init             Alias for `reconcile`; called from bspwmrc autostart.
#   attach           Alias for `reconcile`; called from a hotplug event.
#   detach           Alias for `reconcile`; called from a hotplug event.
#   position [dir]   With no arg, echo the saved external direction. With
#                    `west|south|north|east`, persist it and re-apply xrandr
#                    if an external is currently connected.
#
# Topology rules:
#   - The laptop output is `eDP`.
#   - The external is the first non-eDP `connected` output in `xrandr -q`.
#   - When external is present: external is primary; its cardinal position
#     relative to the laptop is read from the state file (default `east`,
#     i.e. eDP --left-of external). Each monitor owns 10 desktops; the
#     external's are suffixed `.x` so bspwm's globally-unique-name
#     constraint is satisfied. Initial focus lands on external slot 1
#     (`tty.x`).
#   - When external is absent: any leftover non-laptop bspwm monitor has
#     its windows merged onto the laptop by slot index (external slot N's
#     windows move to laptop slot N), then it is removed.

set -eu

readonly LAPTOP='eDP'
readonly STATE_FILE="${XDG_STATE_HOME:-${HOME}/.local/state}/bspwm/monitor-position"
readonly DEFAULT_POSITION='east'

# Print the first connected non-laptop output from xrandr, or empty.
external_output() {
  xrandr -q | awk -v laptop="$LAPTOP" '
    $2 == "connected" && $1 != laptop { print $1; exit }
  '
}

# True if $1 appears as a `connected` output in xrandr.
output_is_connected() {
  xrandr -q | awk -v out="$1" '
    $1 == out && $2 == "connected" { found = 1 }
    END { exit !found }
  '
}

# Echo the saved external direction, falling back to DEFAULT_POSITION when
# the state file is missing or its contents aren't a recognized cardinal.
read_position() {
  if [ -r "$STATE_FILE" ]; then
    dir=$(cat -- "$STATE_FILE" 2>/dev/null || true)
    case "$dir" in
      west | south | north | east)
        printf '%s\n' "$dir"
        return 0
        ;;
    esac
  fi
  printf '%s\n' "$DEFAULT_POSITION"
}

# Persist $1 as the external direction, creating the parent dir if needed.
write_position() {
  mkdir -p -- "${STATE_FILE%/*}"
  printf '%s\n' "$1" >"$STATE_FILE"
}

# Lay out external $1 and the laptop via xrandr, with the external in the
# cardinal direction $2 relative to the laptop. External is always primary.
apply_position() {
  ext="$1"
  case "$2" in
    west) rel='--right-of' ;;
    east) rel='--left-of' ;;
    north) rel='--below' ;;
    south) rel='--above' ;;
  esac
  xrandr \
    --output "$ext" --primary --auto \
    --output "$LAPTOP" --auto "$rel" "$ext"
}

# Reset desktops on the laptop monitor to the named single-monitor set.
set_laptop_desktops() {
  set -- tty browse d3 d4 d5 d6 d7 d8 d9 d0
  bspc monitor "$LAPTOP" --reset-desktops "$@"
}

# Reset desktops on the external monitor to the suffixed dual-monitor set.
set_external_desktops() {
  ext="$1"
  set -- tty.x browse.x d3.x d4.x d5.x d6.x d7.x d8.x d9.x d0.x
  bspc monitor "$ext" --reset-desktops "$@"
}

# Move every node from $src desktop to $dst desktop. No-op if $src is gone.
merge_nodes() {
  src="$1"
  dst="$2"
  if ! bspc query -D -d "$src" >/dev/null 2>&1; then
    return 0
  fi
  bspc query -N -d "$src" | while read -r node; do
    [ "$node" != "" ] || continue
    bspc node "$node" --to-desktop "$dst" >/dev/null 2>&1 || true
  done
}

# Configure dual-monitor topology with $ext as primary in the saved direction.
reconcile_attach() {
  ext="$1"
  apply_position "$ext" "$(read_position)"

  # Wait for bspwm to register the new monitor (RandR notify is async).
  i=0
  while [ "$i" -lt 20 ]; do
    if bspc query -M --names | grep -qx -- "$ext"; then
      break
    fi
    sleep 0.05
    i=$((i + 1))
  done

  set_laptop_desktops
  set_external_desktops "$ext"

  # Re-source rules so newly-added monitor matters for desktop= selectors.
  rules="${XDG_CONFIG_HOME:-${HOME}/.config}/bspwm/conf.d/20-rules.sh"
  if [ -r "$rules" ]; then
    # shellcheck source=/dev/null
    . "$rules"
  fi

  # Initial focus: external slot 1.
  bspc desktop "${ext}:^1" --focus >/dev/null 2>&1 || true
}

# Tear down any non-laptop bspwm monitor whose output is no longer connected,
# merging its windows onto the laptop by slot index first.
reconcile_detach() {
  bspc query -M --names | while read -r m; do
    [ "$m" != "" ] || continue
    if [ "$m" = "$LAPTOP" ]; then
      continue
    fi
    if output_is_connected "$m"; then
      continue
    fi
    i=1
    while [ "$i" -le 10 ]; do
      merge_nodes "${m}:^${i}" "${LAPTOP}:^${i}"
      i=$((i + 1))
    done
    bspc monitor "$m" --remove >/dev/null 2>&1 || true
  done

  # Disable any disconnected non-laptop outputs xrandr still tracks.
  xrandr -q | awk '$2 == "disconnected" { print $1 }' \
    | while read -r out; do
      [ "$out" != "" ] || continue
      if [ "$out" != "$LAPTOP" ]; then
        xrandr --output "$out" --off >/dev/null 2>&1 || true
      fi
    done

  set_laptop_desktops
}

# Resync each managed window's _NET_WM_DESKTOP to its desktop's index.
sync_ewmh_desktop() {
  # bspc moves keep internal state correct but leave the X11 property stale
  # on cross-monitor moves; rofi -modi window and other EWMH consumers show
  # 'n/a' otherwise. bspc emits desktops in the same order bspwm uses for
  # _NET_DESKTOP_NAMES, so NR-1 is the correct 0-based global index.
  command -v xprop >/dev/null 2>&1 || return 0
  map=$(bspc query -D --names 2>/dev/null | awk 'NF { print $0 "\t" NR - 1 }')
  [ "$map" != "" ] || return 0
  bspc query -N --node .window 2>/dev/null | while read -r node; do
    [ "$node" != "" ] || continue
    d=$(bspc query -D -n "$node" --names 2>/dev/null)
    [ "$d" != "" ] || continue
    idx=$(printf '%s\n' "$map" \
      | awk -F'\t' -v name="$d" '$1 == name { print $2; exit }')
    [ "$idx" != "" ] || continue
    xprop -id "$node" -f _NET_WM_DESKTOP 32c \
      -set _NET_WM_DESKTOP "$idx" >/dev/null 2>&1 || true
  done
}

reconcile() {
  if ! command -v xrandr >/dev/null 2>&1; then
    printf 'bspwm-monitor: xrandr not installed; cannot reconcile.\n' >&2
    return 1
  fi
  ext=$(external_output)
  if [ "$ext" != "" ]; then
    reconcile_attach "$ext"
  else
    reconcile_detach
  fi
  sync_ewmh_desktop
}

# Get or set the external's cardinal direction relative to the laptop.
# No arg: echo the current effective direction. Otherwise persist $1 and
# re-apply xrandr if an external is currently connected (the preference is
# stored either way, so it takes effect on the next attach).
position() {
  if [ "$#" -eq 0 ]; then
    read_position
    return 0
  fi
  case "$1" in
    west | south | north | east) ;;
    *)
      printf 'usage: %s position [west|south|north|east]\n' \
        "${0##*/}" >&2
      exit 2
      ;;
  esac
  write_position "$1"
  ext=$(external_output)
  if [ "$ext" != "" ]; then
    apply_position "$ext" "$1"
  fi
}

main() {
  cmd="${1:-reconcile}"
  case "$cmd" in
    reconcile | init | attach | detach)
      reconcile
      ;;
    position)
      shift
      position "$@"
      ;;
    *)
      printf 'usage: %s {reconcile|init|attach|detach|position [dir]}\n' \
        "${0##*/}" >&2
      exit 2
      ;;
  esac
}

main "$@"
