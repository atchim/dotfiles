#!/bin/sh

# bspwm-send-parallel — send the focused window to its parallel desktop:
# the same slot on the other monitor, keeping the desktop's slot. With at
# most two monitors, the parallel desktop is just the focused desktop's
# name with the external `-x` suffix toggled (see bspwm-monitor): a laptop
# desktop `browse` pairs with the external `browse-x`, and vice versa.

set -eu

# Print usage to stderr and exit non-zero.
usage() {
  printf 'usage: %s {stay|follow}\n' "${0##*/}" >&2
  exit 2
}

main() {
  [ "$#" -eq 1 ] || usage
  case "$1" in
    stay | follow) ;;
    *) usage ;;
  esac

  # A window must be focused to move it.
  bspc query -N -n focused >/dev/null 2>&1 || exit 0

  # Toggle the `-x` suffix to reach the same slot on the other monitor.
  cur=$(bspc query -D -d focused --names)
  case "$cur" in
    *-x) dest="${cur%-x}" ;;
    *) dest="${cur}-x" ;;
  esac

  # No-op when the parallel desktop doesn't exist (e.g. single monitor).
  bspc query -D -d "$dest" >/dev/null 2>&1 || exit 0

  if [ "$1" = follow ]; then
    bspc node -d "$dest" --follow
  else
    bspc node -d "$dest"
  fi
}

main "$@"
