# Functions
# ---------

test_cmd() { command -v "$1" >/dev/null; }

push_dir() {
  local dir="$1"
  local var="${2:-PATH}"
  [[ -d $dir ]] && eval "export $var=\"$dir\${$var:+:\$$var}\""
}

# PATH
# ----

test_cmd ccache && push_dir /usr/lib/ccache/bin
push_dir "$HOME/.local/bin"
push_dir "$HOME/.opencode/bin"

# cargo
# -----

# shellcheck disable=SC1090
[[ -f ~/.cargo/env ]] && . ~/.cargo/env

# pnpm
# ----

export PNPM_HOME="$HOME/.local/share/pnpm"
push_dir "$PNPM_HOME/bin"

# npm
# ---

export NPM_CONFIG_PREFIX="$HOME/.local/npm"
push_dir "$NPM_CONFIG_PREFIX/bin"

# bun
# ---

export BUN_INSTALL="$HOME/.bun"
push_dir "$BUN_INSTALL/bin"

# Env Vars
# --------

push_dir "$HOME/.local/share/man" MANPATH

# Neovim
# ------

test_cmd nvim && export EDITOR=nvim

# Inherit Bashrc
# --------------

# shellcheck disable=SC1090
[[ -f ~/.bashrc ]] && . ~/.bashrc

# vim: ft=bash
